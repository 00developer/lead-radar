# Copy to .env and fill in. Never commit .env, never paste its values in chat. Names only here.

# Database (Supabase project of this app, not the social-posting one).
# Supabase dashboard -> Connect -> connection string (use the pooler string for a normal run). Contains the DB password.
DATABASE_URL=
# Only if Node does not trust the database certificate: path to the CA certificate file that Supabase provides. Do not turn TLS checks off.
DATABASE_SSL_CA_PATH=

# LLM (Gemini). Free tier for development, a paid key before real customer data (decision D-35).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
CLASSIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING=low

# Apify (Threads posts until the official API is approved)
APIFY_TOKEN=
APIFY_ACTOR_ID=webdata_labs/threads-scraper
APIFY_PRICE_PER_1K_USD=3

# Official Threads API (development token only; Phase 2 replaces it with OAuth)
THREADS_ACCESS_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
META_APP_ID=
META_APP_SECRET=

# Hard limits
COLLECT_MAX_RESULTS=100
COLLECT_MAX_SPEND_USD=0.5
CLASSIFY_MAX_CALLS_PER_RUN=100
AI_MONTHLY_CEILING=2000

# Supabase project (dashboard login and Row Level Security). The secret key is server side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App address, Threads OAuth and scheduler
APP_URL=http://localhost:3000
THREADS_REDIRECT_URI=
ENCRYPTION_KEY=
CRON_SECRET=

# Email alerts (Resend)
EMAIL_API_KEY=
ALERT_FROM_EMAIL=

# Only for "npm run create-user". Remove OWNER_PASSWORD afterwards.
OWNER_EMAIL=
OWNER_PASSWORD=
