# Names only. Put real values in spike/.env yourself. Never paste keys in chat.
APIFY_TOKEN=

# LLM for the classification test. Default provider is Gemini (owner's choice).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Free Flash model by default. A Pro model needs billing enabled on the Google key.
CLASSIFIER_MODEL=gemini-3.8-flash
# low | minimal | medium | high | none
GEMINI_THINKING=low

# Only needed if you also want to compare with Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Hard stop: total Apify spend allowed across all spike runs (USD). Free plan credit is about 5.
APIFY_TOTAL_BUDGET_USD=4
# Hard stop: total classification calls
CLASSIFY_MAX_CALLS=100
